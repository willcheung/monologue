{
  "name": "monologue",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:privacy": "vitest run tests/public-repo.test.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:turso": "node --env-file=.env.local --import tsx scripts/migrate-turso.ts",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test:mcp": "vitest run tests/mcp.test.ts",
    "test:libsql": "MCP_TEST_LIBSQL=1 vitest run tests/mcp.test.ts tests/workspaces.test.ts tests/api-routes.test.ts",
    "test:reporter": "python3 -m unittest discover -s tests -p '*_test.py'",
    "dev:workspace": "node scripts/workspace-dev.mjs",
    "test:onboarding": "vitest run tests/agent-onboarding.test.tsx tests/setup-context.test.ts tests/setup-prompt.test.ts tests/agent-setup.test.ts tests/mcp-setup.test.tsx tests/mcp-consent.test.tsx tests/oauth-completion.test.tsx tests/onboarding-protocol.test.ts tests/mcp.test.ts tests/api-routes.test.ts",
    "test:onboarding:clients": "MONOLOGUE_NATIVE_TESTS=1 vitest run tests/onboarding-clients.test.ts",
    "test:onboarding:sessions": "MONOLOGUE_SESSION_TESTS=1 vitest run tests/onboarding-sessions.test.ts",
    "test:onboarding:install": "MONOLOGUE_INSTALL_TESTS=1 vitest run tests/onboarding-install.test.ts",
    "test:onboarding:app-server": "MONOLOGUE_APP_SERVER_TESTS=1 vitest run tests/onboarding-protocol.test.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.5",
    "@libsql/client": "0.8.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@prisma/adapter-libsql": "^6.12.0",
    "@prisma/client": "6.12.0",
    "@sentry/nextjs": "11.6.0",
    "better-auth": "^1.7.5",
    "lucide-react": "1.47.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "roughjs": "^4.6.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.8",
    "prisma": "6.12.0",
    "tailwindcss": "latest",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "prisma": {
    "seed": "node --env-file=.env --import tsx prisma/seed.ts"
  }
}
