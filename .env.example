DATABASE_URL="file:./monologue.db"
MONOLOGUE_MODE="single-user"
MONOLOGUE_API_KEY="change-me"
MONOLOGUE_URL="http://localhost:3000"

# Hosted mode
# TURSO_DATABASE_URL="libsql://..."
# TURSO_AUTH_TOKEN="..."
# BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
# BETTER_AUTH_URL="https://monologue.example.com"
# GOOGLE_CLIENT_ID="..."
# GOOGLE_CLIENT_SECRET="..."

# OAuth MCP (hosted mode; apply migrations before enabling)
# MONOLOGUE_MCP_ENABLED="1"
# MONOLOGUE_MCP_ALLOWED_ORIGINS="https://your-other-browser-client.example"

# OpenAI marketplace domain verification (production configuration only)
# MONOLOGUE_OPENAI_DOMAIN_VERIFICATION_TOKEN=""

# Optional operator-owned legal documents (JSON; server-side configuration).
# See docs/HOSTED_ARCHITECTURE.md. Never prefix these with NEXT_PUBLIC_.
# MONOLOGUE_TERMS_DOCUMENT=""
# MONOLOGUE_PRIVACY_DOCUMENT=""

# Optional workspace invitation emails. Verify a sender domain before enabling.
# RESEND_API_KEY=""
# MONOLOGUE_EMAIL_FROM="Monologue <support@your-domain.example>"
# MONOLOGUE_EMAIL_REPLY_TO="support@your-domain.example"

# Optional Sentry error monitoring. Use a separate project for this application.
# Reporting is off without a DSN and during `next dev`.
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_DSN="" # Optional server override; otherwise uses the public DSN.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="production" # Use staging in a staging deployment.
# SENTRY_ENVIRONMENT="production" # Match the public environment.
# SENTRY_ORG="your-organization"
# SENTRY_PROJECT="your-monologue-project"
# SENTRY_RELEASE="" # Defaults to the Vercel Git commit SHA when available.
# SENTRY_AUTH_TOKEN="" # Owner-managed build secret; never use NEXT_PUBLIC_.
